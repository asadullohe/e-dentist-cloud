# Serverdagi muhit. Nusxa koʻchiring va toʻldiring:
#   cp .env.prod.example .env
#
# Bu fayl serverda `/opt/e-dentist/.env` boʻlib turadi va git ga
# HECH QACHON tushmaydi. Parollarni generatsiya qiling:
#   openssl rand -base64 32

# --- Domen va HTTPS ---
# Faqat ikkita subdomen ilovaga tegishli: cabinet. va admin.
# Apex va www — Netlify'dagi landing, tegilmaydi
DOMAIN=e-dentist.uz
# Let's Encrypt shu manzilga sertifikat muddati haqida yozadi
ACME_EMAIL=siz@example.com

# --- Postgres ---
POSTGRES_USER=edentist
POSTGRES_PASSWORD=<openssl rand -base64 32>
POSTGRES_DB=edentist
# Ilova shu rol bilan ulanadi — superuser EMAS, aks holda RLS
# siyosatlari chetlab oʻtiladi va koʻp ijarachilik himoyasi qolmaydi
APP_DB_USER=edentist_app
APP_DB_PASSWORD=<openssl rand -base64 32>

# Konteyner tarmogʻi ichidagi manzillar: xost nomi = servis nomi
DATABASE_URL=postgresql://edentist:<POSTGRES_PASSWORD>@postgres:5432/edentist
APP_DATABASE_URL=postgresql://edentist_app:<APP_DB_PASSWORD>@postgres:5432/edentist
REDIS_URL=redis://redis:6379

# --- MinIO ---
MINIO_ROOT_USER=edentist
MINIO_ROOT_PASSWORD=<kamida 8 belgi>
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=edentist
S3_SECRET_KEY=<MINIO_ROOT_PASSWORD bilan bir xil>
S3_BUCKET=edentist-files

# --- API ---
TZ=Asia/Tashkent
SESSION_SECRET=<openssl rand -base64 32>
# Xatdagi havolalar shu manzilga quriladi
CABINET_URL=https://cabinet.e-dentist.uz

# --- Pochta (majburiy) ---
# Sozlanmagan boʻlsa server koʻtarilmaydi: pochta tasdigʻisiz hech kim
# kabinetga kira olmaydi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=E-Dentist <bot@e-dentist.uz>

# --- Telegram (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tasvirlar ---
# Birinchi chiqarishda tasvirlar serverning oʻzida quriladi va bu
# qatorlar KERAK EMAS — shundayligicha izohda qoldiring.
#
# GitHub Actions ni yoqqaningizda izohni olib, oʻz nomingizni yozasiz:
# IMAGE_API=ghcr.io/asadullohe/e-dentist-cloud-api
# IMAGE_WEB=ghcr.io/asadullohe/e-dentist-cloud-web
# TAG=latest

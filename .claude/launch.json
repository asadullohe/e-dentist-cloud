{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kabinet",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@e-dentist/cabinet",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@e-dentist/admin"],
      "port": 5174,
      "autoPort": false
    }
  ]
}

// Maʼlumotlar modeli, 1-qism: klinika, xodimlar, rollar, taklifnomalar, audit.
// Bemorlar va tashriflar bosqich 2.1 da qoʻshiladi.
//
// Qoidalar (tz.md 5-boʻlim):
//   · har ijarachi jadvalida clinic_id ustuni bor
//   · pul — butun son (soʻm), kasr yoʻq
//   · ish sanalari DATE, texnik vaqt belgilari timestamptz
//   · maʼlumot hech qachon oʻchirilmaydi — status bilan faolsizlantiriladi

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Ulanish manzili prisma.config.ts da — Prisma 7 dan boshlab sxemada
// url turmaydi
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────  Klinika  ─────────────────────────────

enum ClinicStatus {
  active
  blocked
}

/// Ijarachi. Sinov ham shu qator, faqat is_trial = true
model Clinic {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  phone     String?
  status    ClinicStatus @default(active)
  /// Tarif nomi. Narx modeli hali belgilanmagan (reja.md, ochiq savol 1) —
  /// shuning uchun enum emas, matn
  plan      String       @default("asosiy")
  isTrial   Boolean      @default(true) @map("is_trial")
  /// Obuna tugash sanasi. Bundan keyin faqat oʻqish rejimi
  expiresAt DateTime     @map("expires_at") @db.Date
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users        User[]
  roles        Role[]
  invites      Invite[]
  auditLog     AuditLog[]
  patients     Patient[]
  visits       Visit[]
  teeth        Tooth[]
  bridges      Bridge[]
  payments     Payment[]
  appointments Appointment[]
  services     Service[]
  images       PatientImage[]
  expenses     Expense[]

  @@index([status])
  @@map("clinics")
}

// ──────────────────────────  Rollar va ruxsatlar  ──────────────────────────

/// Rol shablonlari. Klinika roʻyxatdan oʻtganda beshtasi ham nusxalanadi
/// va oʻsha klinikaga tegishli boʻlib qoladi (tz.md 6-boʻlim)
enum RoleTemplate {
  egasi
  shifokor
  qabulxona
  texnik
  kuzatuvchi
}

model Role {
  id          String       @id @default(uuid(7)) @db.Uuid
  clinicId    String       @map("clinic_id") @db.Uuid
  template    RoleTemplate
  name        String
  /// packages/shared dagi RUXSATLAR roʻyxatidan
  permissions String[]
  /// Egasi roli oʻchirilmaydi va staff.manage / billing.manage ni yoʻqotmaydi
  isOwner     Boolean      @default(false) @map("is_owner")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  users   User[]
  invites Invite[]

  /// 1-versiyada klinika yangi rol yarata olmaydi — har shablondan bittadan
  @@unique([clinicId, template])
  @@index([clinicId])
  @@map("roles")
}

// ─────────────────────────────  Xodimlar  ─────────────────────────────

enum UserStatus {
  active
  disabled
}

/// Xodim hech qachon oʻchirilmaydi: ishdan boʻshasa status = disabled.
/// Uning tashriflari va audit yozuvlari joyida qoladi
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Platforma admini uchun boʻsh — u hech qaysi klinikaga tegishli emas
  clinicId        String?    @map("clinic_id") @db.Uuid
  roleId          String?    @map("role_id") @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String?    @map("full_name")
  status          UserStatus @default(active)
  /// Tasdiqlanmaguncha kabinet ochilmaydi
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// Tasdiqlash havolasidagi kalitning xeshi. Kalitning oʻzi faqat xatda boʻladi
  emailVerifyTokenHash  String?   @unique @map("email_verify_token_hash")
  emailVerifyExpiresAt  DateTime? @map("email_verify_expires_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@map("users")
}

// ────────────────────────────  Taklifnomalar  ────────────────────────────

/// Xodimni taklif qilish havolasi, 7 kun amal qiladi.
/// Havoladagi kalit bazada saqlanmaydi — faqat uning xeshi. Baza sizib chiqsa
/// ham taklifnomalar bilan hisob ochib boʻlmaydi
model Invite {
  id         String    @id @default(uuid(7)) @db.Uuid
  clinicId   String    @map("clinic_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([email])
  @@map("invites")
}

// ──────────────────────────────  Audit  ──────────────────────────────

/// Tibbiy maʼlumot uchun kim nima qilgani yozilishi shart (tz.md 12-boʻlim):
/// kim, qachon, qaysi bemor yozuvini koʻrgani yoki oʻzgartirgani
model AuditLog {
  id       String   @id @default(uuid(7)) @db.Uuid
  /// Platforma admini amallari uchun boʻsh
  clinicId String?  @map("clinic_id") @db.Uuid
  /// Muvaffaqiyatsiz kirish urinishida foydalanuvchi nomaʼlum boʻlishi mumkin
  userId   String?  @map("user_id") @db.Uuid
  action   String
  entity   String
  entityId String?  @map("entity_id")
  /// Qoʻshimcha tafsilot: IP, nechta qator yuklandi va h.k.
  meta     Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([clinicId, at])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ─────────────────────────────  Bemorlar  ─────────────────────────────

/// Kartoteka. Telefon takrorlanishi mumkin: bitta oiladagi bir necha bemor
/// bitta raqamdan foydalanishi odatiy hol (tz.md 8-boʻlim, Excel dan yuklash)
model Patient {
  id        String    @id @default(uuid(7)) @db.Uuid
  clinicId  String    @map("clinic_id") @db.Uuid
  fio       String
  /// Qidiruv uchun normallashtirilgan nusxa: kichik harf, apostrof
  /// variantlari bir xillashtirilgan. Oʻzbekcha ismlarda «Gʻayrat»,
  /// «G'ayrat» va «G’ayrat» bir xil topilishi kerak (shared normalizeName)
  fioSearch String    @map("fio_search")
  /// Bir xil koʻrinishda: +998901234567
  phone     String?
  birthDate DateTime? @map("birth_date") @db.Date
  address   String?
  /// Allergiya, surunkali kasalliklar
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visits       Visit[]
  teeth        Tooth[]
  bridges      Bridge[]
  payments     Payment[]
  appointments Appointment[]
  images       PatientImage[]

  @@index([clinicId, fioSearch])
  @@index([clinicId, phone])
  @@map("patients")
}

// ────────────────────────  Tashriflar va muolajalar  ────────────────────────

model Visit {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  date      DateTime @db.Date
  /// Muolaja nomi. Narxnomadan tanlansa ham matn saqlanadi — narxnoma
  /// keyin oʻzgarsa tarix buzilmasin
  treatment String
  /// FDI raqami. Bir nechta tish boʻlsa har biriga alohida yozuv
  tooth     Int?
  serviceId String?  @map("service_id") @db.Uuid
  /// Soʻm, butun son
  price     Int      @default(0)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, date])
  @@index([clinicId, date])
  @@map("visits")
}

// ──────────────────────────────  Tish xaritasi  ──────────────────────────────

/// Bemorning bitta tishi. FDI raqamlash: 11–48 doimiy, 51–85 sut tishlari.
/// `status` va `material` enum emas — roʻyxat vaqt oʻtib kengayishi mumkin,
/// har safar migratsiya yozib oʻtirmaslik uchun. Qiymatlar packages/teeth da
model Tooth {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  tooth     Int
  status    String
  material  String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Bitta bemorda bitta tish raqami bir marta
  @@unique([patientId, tooth])
  @@index([clinicId])
  @@map("teeth")
}

/// Koʻprik. Tayanch va oraliq tishlar `teeth` massividagi tartib boʻyicha
/// aniqlanadi — hisoblash packages/teeth dagi bridgeSpan da
model Bridge {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  teeth     Int[]
  material  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId])
  @@map("bridges")
}

// ───────────────────────────────  Toʻlovlar  ───────────────────────────────

/// Qarz = tashriflar summasi − toʻlovlar. Alohida ustunda saqlanmaydi:
/// ikki joyda turgan son ertami-kechmi bir-biridan ajralib qoladi
model Payment {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  date      DateTime @db.Date
  /// Soʻm, butun son
  amount    Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId])
  @@index([clinicId, date])
  @@map("payments")
}

// ─────────────────────────────  Qabul jadvali  ─────────────────────────────

enum AppointmentStatus {
  scheduled
  arrived
  no_show
  done
  cancelled
}

model Appointment {
  id        String            @id @default(uuid(7)) @db.Uuid
  clinicId  String            @map("clinic_id") @db.Uuid
  patientId String            @map("patient_id") @db.Uuid
  /// Qabul vaqti. Navbat (bosqich 4) uchun qoʻshimcha ustunlar keyin qoʻshiladi
  at        DateTime          @db.Timestamptz(3)
  status    AppointmentStatus @default(scheduled)
  note      String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, at])
  @@index([clinicId, patientId])
  @@map("appointments")
}

// ────────────────────────────────  Narxnoma  ────────────────────────────────

model Service {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  name      String
  /// Soʻm, butun son
  price     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visits Visit[]

  @@unique([clinicId, name])
  @@map("services")
}

// ───────────────────────────────  Xarajatlar  ───────────────────────────────

/// Turkumlar oflayn ilovadan koʻchdi. `lab` — texnik ishi: naryad
/// topshirilganda texnik narxi shu turkumda xarajatga tushadi (tz.md 9-boʻlim),
/// busiz hisobotdagi sof foyda yolgʻon chiqadi
enum ExpenseCategory {
  materials
  equipment
  rent
  utilities
  salary
  ads
  tax
  lab
  other
}

model Expense {
  id          String          @id @default(uuid(7)) @db.Uuid
  clinicId    String          @map("clinic_id") @db.Uuid
  date        DateTime        @db.Date
  category    ExpenseCategory @default(other)
  description String
  /// Soʻm, butun son
  amount      Int
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([clinicId, date])
  @@map("expenses")
}

// ────────────────────────────  Bemor rasmlari  ────────────────────────────

model PatientImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  /// MinIO dagi obyekt nomi. Ochiq URL emas — rasm imzolangan vaqtinchalik
  /// havola orqali beriladi (tz.md 12-boʻlim)
  key       String   @unique
  caption   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId])
  @@map("images")
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // prisma CLI ichidagi Prisma Studio ildizga @types/react@19 ni tortib
    // keladi. Kabinetda esa React 18 (tz.md 3-boʻlim). Ikki nusxa boʻlsa
    // TypeScript «JSX component emas» degan chalkash xato beradi, shuning
    // uchun React tiplari aniq koʻrsatiladi
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../../packages/shared/src/**/*",
    "../../packages/ui/src/**/*",
    "../../packages/teeth/src/**/*"
  ]
}

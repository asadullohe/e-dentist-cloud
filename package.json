{
  "name": "e-dentist-cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p apps/api && tsc -p apps/cabinet && tsc -p apps/admin",
    "dev": "npm run dev -w @e-dentist/api",
    "check": "biome check .",
    "fix": "biome check --write .",
    "ci": "biome ci .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db": "docker compose exec postgres psql -U edentist -d edentist",
    "db:migrate": "npm run db:migrate -w @e-dentist/api",
    "db:reset": "npm run db:reset -w @e-dentist/api",
    "db:seed": "npm run db:seed -w @e-dentist/api",
    "db:studio": "npm run db:studio -w @e-dentist/api",
    "db:generate": "npm run db:generate -w @e-dentist/api",
    "db:app-role": "docker compose exec -T postgres bash /docker-entrypoint-initdb.d/01-app-role.sh",
    "dev:admin": "npm run dev -w @e-dentist/admin"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}

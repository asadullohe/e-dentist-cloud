{
  "name": "e-dentist-cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "npm run dev -w @e-dentist/api",
    "check": "biome check .",
    "fix": "biome check --write .",
    "ci": "biome ci .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db": "docker compose exec postgres psql -U edentist -d edentist",
    "db:migrate": "npm exec -w @e-dentist/api -- prisma migrate dev",
    "db:seed": "npm exec -w @e-dentist/api -- prisma db seed",
    "db:studio": "npm exec -w @e-dentist/api -- prisma studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}

# Namuna. Nusxa koʻchiring: cp .env.example .env
# .env HECH QACHON git ga tushmaydi — ichida haqiqiy parollar boʻladi.

# --- Postgres ---
POSTGRES_USER=edentist
POSTGRES_PASSWORD=<parol>
POSTGRES_DB=edentist
# 5432 notebookda Homebrew PostgreSQL 14 tomonidan band — shuning uchun 5433.
# Konteyner ichida port baribir 5432, serverda ham 5432 boʻladi.
POSTGRES_PORT=5433

# API ishga tushganda shu foydalanuvchi bilan ulanadi. Superuser EMAS —
# aks holda Postgres RLS siyosatlari chetlab oʻtiladi va koʻp ijarachilik
# himoyasi ishlamay qoladi. DATABASE_URL esa faqat migratsiya va seed uchun
APP_DB_USER=edentist_app
APP_DB_PASSWORD=<parol>

# --- Redis (sessiya) ---
REDIS_PORT=6379

# --- MinIO (bemor rasmlari) ---
MINIO_ROOT_USER=edentist
MINIO_ROOT_PASSWORD=<kamida 8 belgi>
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=edentist-files

# --- Fayl saqlagich (MinIO, S3 mos) ---
# Endpoint MinIO ga koʻrsatadi, lekin kod S3 mijozi bilan ishlaydi —
# boshqa provayderga oʻtish kerak boʻlsa faqat shu manzil oʻzgaradi
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<kalit>
S3_SECRET_KEY=<maxfiy kalit>
S3_BUCKET=edentist-files

# --- API (bosqich 1.3 dan ishlatiladi) ---
# Sanalar shu zonaga tayanadi. Konteyner sukut boʻyicha UTC da —
# tuzatilmasa «bugun» besh soatga surilib ketadi
TZ=Asia/Tashkent
NODE_ENV=development
API_PORT=3000
# Pochtani tasdiqlash havolasi shu manzilga quriladi
CABINET_URL=http://localhost:5173
DATABASE_URL=postgresql://edentist:<parol>@localhost:5433/edentist
REDIS_URL=redis://localhost:6379
# Migratsiya va seed — egasi (superuser). RLS unga taʼsir qilmaydi
# Ishga tushirish — cheklangan foydalanuvchi. RLS ostida
APP_DATABASE_URL=postgresql://edentist_app:<parol>@localhost:5433/edentist
SESSION_SECRET=<tasodifiy uzun satr: openssl rand -base64 32>

# --- Pochta (SMTP) ---
# Lokalda boʻsh qoldiring: xat konsolga chiqadi va havolani terminaldan
# nusxalab olasiz. Serverda esa toʻrttasi ham shart — aks holda server
# umuman koʻtarilmaydi: pochta tasdigʻisiz hech kim kabinetga kira olmaydi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=E-Dentist <bot@e-dentist.uz>

# --- Telegram xabarnomasi ---
# Yangi klinika roʻyxatdan oʻtganda shu chatga xabar keladi.
# Boʻsh boʻlsa xabar yuborilmaydi — bu xato emas.
# Token: @BotFather, chat id: botga yozib @userinfobot dan olinadi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

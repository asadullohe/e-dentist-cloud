# Caddy sozlamasi. HTTPS avtomatik: Let's Encrypt sertifikati birinchi
# soʻrovda olinadi va oʻzi yangilanadi.
#
# Uchta manzil bitta serverda:
#   e-dentist.uz          landing (www apex ga yoʻnaltiriladi)
#   kabinet.e-dentist.uz  klinikalar kabineti
#   admin.e-dentist.uz    boshqaruv paneli

{
	email {$ACME_EMAIL}

	log {
		output stdout
		format console
	}

	servers {
		# Cloudflare proxy («orange cloud») orqasida turibmiz: soʻrovlar
		# uning IP laridan keladi. Bu roʻyxatsiz har bir mijoz Cloudflare
		# IP si boʻlib koʻrinadi va navbatdagi «bir IP dan soatiga 5 ta
		# yozuv» cheklovi butun mamlakatga bitta boʻlib qolardi.
		#
		# Roʻyxatni yangilash: curl https://www.cloudflare.com/ips-v4
		#                      curl https://www.cloudflare.com/ips-v6
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(xavfsizlik) {
	header {
		# Brauzer faqat HTTPS orqali kelsin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Server nomi va versiyasi koʻrinmasin
		-Server
	}
}

(api) {
	handle /api/* {
		reverse_proxy api:3000 {
			# Navbat sahifasi SSE bilan ishlaydi: oqim buferlanmasin,
			# aks holda «chaqirildi» xabari kech keladi
			flush_interval -1
			# Cheklovlar IP boʻyicha ishlaydi. `remote_host` — yuqoridagi
			# trusted_proxies tufayli haqiqiy mijoz manzili
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# ─────────────────────────────  Landing  ─────────────────────────────

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	import xavfsizlik

	root * /srv/landing
	encode gzip zstd

	# Shrift va rasmlar nom bilan versiyalanadi — uzoq keshlanadi
	@statik path /fonts/* /img/*
	header @statik Cache-Control "public, max-age=604800"

	# APK ni brauzer matn deb ochib yubormasin
	@apk path /downloads/*.apk
	header @apk Content-Type "application/vnd.android.package-archive"

	file_server
}

# ──────────────────────────  Kabinet va panel  ──────────────────────────

kabinet.{$DOMAIN} {
	import xavfsizlik
	import api

	handle {
		root * /srv/kabinet
		encode gzip zstd
		# SPA: ichki marshrutlar (masalan /n/abc123) index.html ga tushadi
		try_files {path} /index.html
		file_server
	}
}

admin.{$DOMAIN} {
	import xavfsizlik
	import api

	handle {
		root * /srv/admin
		encode gzip zstd
		try_files {path} /index.html
		file_server
	}
}
